# Example environment file
# Copy this to .env.local and add your actual API key

# DeepSeek API Key - powers the chat (DeepSeek V4 Flash)
# Get one from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: override the chat model (defaults to deepseek-v4-flash)
# DEEPSEEK_MODEL=deepseek-v4-flash

# Resend API Key for contact form emails
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Alternative API providers (swap the endpoint in pages/api/ask.ts to use one):
# OPENAI_API_KEY=your_openai_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# TOGETHER_AI_API_KEY=your_together_ai_key_here
